# Application and local development authentication
PAYLENS_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYLENS_DEV_API_KEY=replace-with-a-long-random-local-key
PAYLENS_DEV_API_KEY=replace-with-the-same-long-random-local-key
PAYLENS_DEV_MERCHANT_NAME=Local PayLens Merchant
PAYLENS_FRONTEND_URL=http://localhost:3000

# PostgreSQL (matches compose.yaml)
DATABASE_URL=postgresql+psycopg://paylens:replace-local-password@localhost:5432/paylens
POSTGRES_DB=paylens
POSTGRES_USER=paylens
POSTGRES_PASSWORD=replace-local-password

# Stripe connection mode. Use SANDBOX_KEY for one private test account while
# Stripe external OAuth testing is unavailable. Use OAUTH for merchant installs.
STRIPE_CONNECTION_MODE=SANDBOX_KEY
STRIPE_SANDBOX_API_KEY=rk_test_replace_me
STRIPE_SANDBOX_ACCOUNT_ID=acct_replace_me

# Stripe App OAuth 2.0 sandbox/test configuration (not required in SANDBOX_KEY mode)
STRIPE_APP_CLIENT_ID=replace-with-stripe-app-client-id
STRIPE_APP_DEVELOPER_API_KEY=sk_test_replace_me
STRIPE_OAUTH_REDIRECT_URI=http://localhost:8000/providers/stripe/oauth/callback
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYLENS_CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key
PAYLENS_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

# Never commit a populated .env file or provider credentials.

# AWS-only values are injected by ECS/Secrets Manager, not local .env files:
# AWS_REGION, COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, DB_HOST/DB_USERNAME/
# DB_PASSWORD, PAYLENS_RAW_BUCKET, PAYLENS_RAW_KMS_KEY_ID, and SQS queue URLs.
