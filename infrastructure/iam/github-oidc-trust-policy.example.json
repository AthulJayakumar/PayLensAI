{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubPilotEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::169133351222:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:REPLACE_GITHUB_OWNER/REPLACE_GITHUB_REPOSITORY:environment:pilot"
        }
      }
    }
  ]
}
